{
  "name": "shotlab",
  "private": true,
  "version": "1.0.0",
  "description": "Offseason Basketball Development Platform",
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-route-enhancers.mjs dev && vite --host 0.0.0.0 --port 4173",
    "prepare:route-enhancers": "node scripts/run-route-enhancers.mjs build",
    "build": "npm run prepare:route-enhancers && vite build --config vite.phase5b.config.js && node scripts/optimize-production-css.mjs && node scripts/restructure-production-css.mjs && node scripts/prune-overridden-coach-declarations.mjs && node scripts/prune-unreferenced-keyframes.mjs && node scripts/prune-unreachable-global-selectors.mjs && node scripts/dedupe-coach-font-stacks.mjs && node scripts/restructure-production-css.mjs --final-coach && node scripts/remove-unreferenced-authority-css.mjs && node scripts/dedupe-authenticated-font-stacks.mjs && node scripts/restructure-production-css.mjs --final-coach && node scripts/enforce-coach-mobile-identity-authority.mjs && node scripts/recompress-production-js.mjs",
    "build:performance": "npm run build && npm run verify:performance-budget",
    "test": "node --test tests/**/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:season-archive": "playwright test tests/e2e/season-archive.spec.mjs",
    "test:e2e:player-career-history": "playwright test tests/e2e/player-career-history.spec.mjs --config=playwright.acceptance.config.mjs",
    "test:e2e:visual-hierarchy": "playwright test tests/e2e/visual-hierarchy.spec.mjs",
    "test:e2e:mobile-navigation": "playwright test tests/e2e/mobile-navigation.spec.mjs",
    "test:e2e:semantic-colors": "playwright test tests/e2e/semantic-color-system.spec.mjs",
    "test:e2e:phase1a": "playwright test --config=playwright.phase1a.config.mjs",
    "test:e2e:phase1b": "playwright test --config=playwright.phase1b.config.mjs",
    "debug:viewport": "node scripts/viewport-debug.mjs",
    "verify:viewport-debug-tooling": "node --test tests/viewport-debug-tooling.test.mjs",
    "verify:phase3r": "node --test tests/phase-3r-player-progress-intelligence.test.mjs tests/phase-3q-player-session-closeout.test.mjs",
    "preview": "vite preview",
    "deploy:cloudflare": "npm run build && npx wrangler pages deploy dist --project-name shotlab3",
    "dev:agent": "npm run dev",
    "preview:agent": "vite preview --host 0.0.0.0 --port 4173",
    "doctor": "node scripts/doctor.mjs",
    "native:doctor": "node scripts/native-release-doctor.mjs",
    "native:install:toolchain": "node scripts/native-ios.mjs install",
    "native:prepare:ios": "node scripts/native-ios.mjs prepare",
    "native:sync:ios": "node scripts/native-ios.mjs sync",
    "native:verify:ios": "node scripts/native-release-doctor.mjs",
    "native:open:ios": "node scripts/native-ios.mjs open",
    "ios:configure-signing": "node scripts/configure-ios-signing.mjs",
    "ios:validate": "node scripts/ios-release.mjs validate",
    "ios:simulator-build": "node scripts/ios-release.mjs simulator",
    "ios:device-build": "node scripts/ios-release.mjs device",
    "ios:archive": "node scripts/ios-release.mjs archive",
    "verify:leaderboards:supabase": "node --test tests/live-supabase-leaderboard-smoke.test.mjs",
    "verify:performance-budget": "node scripts/verify-performance-budget.mjs",
    "verify:team-store-partner": "node scripts/verify-team-store-partner.mjs",
    "ios:generate-assets": "node scripts/generate-ios-assets.mjs"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "file:vendor/recharts"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "csso": "5.0.5",
    "lightningcss": "1.33.0",
    "terser": "5.49.2",
    "vite": "^5.4.0"
  }
}
